  {
    "id": "relay",
    "title": "Relay",
    "client": "Illustrative commission",
    "sector": "Financial services",
    "role": "Design strategy lead",
    "summary": "Give lending teams one view of a decision.",
    "problem": "Applications moved between risk, operations, and relationship teams without a shared view of what was missing.",
    "approach": "Build a decision map around the evidence each team needs, then prototype a queue that makes ownership explicit.",
