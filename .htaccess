DirectoryIndex index.html
Options -MultiViews

<IfModule mod_rewrite.c>
RewriteEngine On

# Canonicalize only the production apex; localhost and Build remain accessible.
RewriteCond %{HTTP_HOST} ^vanshea\.com(?::[0-9]+)?$ [NC]
RewriteRule ^ https://www.vanshea.com%{REQUEST_URI} [R=301,L,NE]

RewriteRule ^experience/?$ /experience.html [R=302,L]
RewriteRule ^login/?$ / [R=302,L]
RewriteRule ^app(?:/.*)?$ / [R=302,L]
RewriteRule ^analytics(?:/.*)?$ / [R=302,L]
RewriteRule ^vscimage(?:/.*)?$ / [R=302,L]
</IfModule>

ErrorDocument 404 /index.html
