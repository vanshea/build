<header class="site-header">
  <a href="/" class="brand" aria-label="Back to homepage">
    <picture>
      <source
        id="brandLogoDarkSource"
        srcset="/assets/web_logomark_240_white.png"
        media="(prefers-color-scheme: dark)"
      />
      <img
        id="brandLogoLightImage"
        class="brand-logo"
        src="/assets/web_logomark_240_dark.png"
        alt="VSS logo"
      />
    </picture>
    <span class="brand-name">Van Shea Creative</span>
  </a>
  <button
    class="nav-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="siteNav"
    aria-label="Open navigation menu"
  >
    <span class="sr-only">Toggle navigation</span>
    <span class="nav-toggle-icon" aria-hidden="true">
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </span>
  </button>
  <nav id="siteNav" class="nav">
    <a href="/#work" <%= currentPath === "/" ? 'aria-current="page"' : "" %>>Work</a>
    <a
      href="/experience.html"
      <%= currentPath === "/experience.html" ? 'aria-current="page"' : "" %>
    >
      Experience
    </a>
    <a
      href="/case-studies"
      <%= currentPath.startsWith("/case-studies") ? 'aria-current="page"' : "" %>
    >
      Case Studies
    </a>
    <a
      href="/blog/"
      <%= currentPath.startsWith("/blog") ? 'aria-current="page"' : "" %>
    >
      Blog
    </a>
  </nav>
</header>
